# Copy this file to .env and fill in the values. Never commit .env.
# Variables marked REQUIRED must be set for the app to start.

# --- OpenRouter (text LLMs: interviewer brain, analysis, evaluation) ---
# Get a key at https://openrouter.ai/settings/keys
# REQUIRED
OPENROUTER_API_KEY=

# --- ElevenLabs (speech-to-text with Scribe v2 Realtime, text-to-speech with Flash) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
# The key needs access to Speech to Text, Text to Speech, and (for the Agents spike) ElevenLabs Agents.
# REQUIRED
ELEVENLABS_API_KEY=
# Voice used for the interviewer. Pick one in the ElevenLabs voice library and copy its voice id.
# REQUIRED
ELEVENLABS_VOICE_ID=
# Only for the Agents + Custom LLM spike (Option B). Leave empty until the agent is created.
# Bearer token ElevenLabs Agents send to our Custom LLM route. Any long random string (openssl rand -hex 24).
# Only needed for the Agents transport.
AGENT_LLM_SECRET=
ELEVENLABS_AGENT_ID=

# --- Supabase Postgres (data only; Supabase Storage is not used) ---
# Project settings > Database > Connection string.
# DATABASE_URL: pooled connection (Transaction pooler, port 6543). Used by the app at runtime.
# DIRECT_URL: direct or session-pooler connection (port 5432). Used for migrations.
# REQUIRED
DATABASE_URL=
DIRECT_URL=

# --- Vercel Blob (session recordings) ---
# Vercel dashboard > Storage > create a Blob store > copy the read-write token.
# REQUIRED
BLOB_READ_WRITE_TOKEN=

# --- Deployment (optional if you are already logged in with `vercel login`) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Developer tool ---
# 1 shows a "Suggested answer" panel (flagged as a developer tool) with a strong answer to read aloud. Leave empty to hide it.
DEV_MODE=

# --- Voice transport ---
# scribe: our own turn-taking with Scribe v2 Realtime and Flash (default). agent: ElevenLabs Agents with our engine as Custom LLM.
VOICE_TRANSPORT=scribe

# --- App access and security ---
# Password shown to reviewers on the demo site (share it in the README). Leave empty to disable the gate.
DEMO_PASSWORD=
# Protects the daily keep-alive cron route. Any long random string (openssl rand -hex 32).
# REQUIRED
CRON_SECRET=

# --- Limits (defaults keep us inside the free tiers; see the plan, section 2 and 4) ---
# Maximum interviews running at once. ElevenLabs Free allows 4 concurrent agent calls.
MAX_CONCURRENT_INTERVIEWS=4
# Maximum interview length in minutes before the slot is released.
MAX_SESSION_MINUTES=25
# Recording storage budget in bytes (800 MB, leaving headroom under Vercel Blob's 1 GB).
STORAGE_BUDGET_BYTES=800000000
# Largest video recording accepted, in bytes (40 MB). Larger files fall back to audio only.
MAX_VIDEO_BYTES=40000000
# Skip recording after this many uploads in a month (Vercel Blob Hobby includes 2,000).
MAX_MONTHLY_UPLOADS=1500

# --- Tests (local only, no real credentials) ---
# Throwaway Postgres for integration tests, for example a local Docker container.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/interviewer_test
